# ---- Server ----
PORT=3001
# Random long string used to sign login session tokens
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database file lives
DATABASE_PATH=./data/repeatflow.db
# Public URL of the frontend (used for OAuth redirect + CORS)
APP_URL=http://localhost:5173
# Public URL of the API (Google redirects back here)
API_URL=http://localhost:3001

# ---- AI (set ONE of these; auto-detected, or force with LLM_PROVIDER=anthropic|openai) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Gmail OAuth (Google Cloud Console -> OAuth client, type "Web application") ----
# Authorised redirect URI must be: {API_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Daily digest fallback transport (only used when the admin has no Gmail connected) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Scheduled jobs (cron syntax, server local time) ----
# Daily Stripe sync at 09:00
CRON_DAILY_SYNC=0 9 * * *
# Daily digest at 07:30 (leave empty to disable)
CRON_DAILY_DIGEST=30 7 * * *
