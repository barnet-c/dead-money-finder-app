{
  "name": "repeat-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Repeat Flow — The Repeat Booking Journal. Service tracking, invoice recovery and reporting for service businesses.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
